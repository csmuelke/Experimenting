{
  "name": "learnsocial",
  "version": "0.1.0",
  "description": "Social learning time tracking application",
  "private": true,
  "workspaces": [
    "mobile",
    "backend",
    "shared"
  ],
  "scripts": {
    "install:all": "npm install && cd mobile && npm install && cd ../backend && npm install && cd ../shared && npm install",
    "dev:backend": "cd backend && npm run dev",
    "dev:mobile": "cd mobile && npm start",
    "build:backend": "cd backend && npm run build",
    "build:mobile": "cd mobile && npm run build",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.2.4"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "keywords": [
    "learning",
    "social",
    "education",
    "time-tracking",
    "mobile-app"
  ],
  "author": "",
  "license": "MIT"
}
